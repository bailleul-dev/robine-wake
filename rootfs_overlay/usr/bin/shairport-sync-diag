#!/bin/sh
# Diagnostic launcher for the AirPlay receiver, driven by RobineWake.AirPlay.Diagnostics.
#
# Shairport Sync 5 only logs to stderr, so this wrapper appends it to a file and
# runs the receiver with a configuration that enables Shairport's own diagnostics.
#
#   SPS_DIAG_CONF  configuration file to use (default /tmp/shairport-diag.conf)
#   SPS_DIAG_LOG   file receiving stderr (default /tmp/shairport-diag.log)
#   SPS_DIAG_PCM   when set, the decoded PCM goes to this file instead of the amplifier
#   SPS_BLOCK_DIAG / SPS_BLOCK_DUMP are read by shairport-sync itself (see the
#   package patch 0002): per-block log lines and raw block dump.
#
# The arguments given by RobineWake.AirPlay ("-c /etc/shairport-sync.conf") are
# ignored: the diagnostic configuration replaces them.

conf="${SPS_DIAG_CONF:-/tmp/shairport-diag.conf}"
log="${SPS_DIAG_LOG:-/tmp/shairport-diag.log}"

if [ -n "$SPS_DIAG_PCM" ]; then
  exec /usr/bin/shairport-sync -c "$conf" -o stdout >"$SPS_DIAG_PCM" 2>>"$log"
fi

exec /usr/bin/shairport-sync -c "$conf" 2>>"$log"
