# runit applets: supervision of the daemon and services (PLT-004)
CONFIG_RUNSV=y
CONFIG_RUNSVDIR=y
CONFIG_SV=y
CONFIG_SV_DEFAULT_SERVICE_DIR="/etc/service"
CONFIG_SVC=y
CONFIG_SVLOGD=y
CONFIG_CHPST=y
# NTP client (PLT-003)
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=n
# Data partition lookup by label
CONFIG_FINDFS=y
CONFIG_BLKID=y
