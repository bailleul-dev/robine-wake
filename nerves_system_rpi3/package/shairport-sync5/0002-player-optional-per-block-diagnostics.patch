From: Robine Wake firmware
Subject: [PATCH] player: optional per-block diagnostics through the environment

When the receiver "plays" but the speaker stays silent, the first question is
whether the source sends silence or whether the decoding chain loses it.
With SPS_BLOCK_DIAG=1 the player logs every 50th incoming block (size and
decoded peak), and with SPS_BLOCK_DUMP=<path> it appends the first 3000
incoming blocks to that file so they can be decoded elsewhere. Both are off
unless the variables are set, so the production binary is unchanged in use.

--- a/player.c	2026-10-10 14:32:31
+++ b/player.c	2026-10-10 14:32:31
@@ -1278,6 +1278,72 @@
           config.current_output_configuration)); // number of frames left in the resampler
   pthread_setcancelstate(oldState, NULL);
   return response;
+}
+
+// Optional per-block diagnostics, enabled through the environment so that a
+// production binary can prove whether silence comes from the source or from
+// the decoding chain:
+//   SPS_BLOCK_DIAG=1      log every 50th incoming block and its decoded peak
+//   SPS_BLOCK_DUMP=<path> append the first 3000 incoming blocks (with their
+//                         ADTS headers for AAC) to <path>
+static void block_diagnostics(rtsp_conn_info *conn, uint8_t *incoming_data,
+                              size_t incoming_data_length, int ret, AVFrame *decoded_frame) {
+  static int diag_enabled = -1;
+  static FILE *dump = NULL;
+  static unsigned count = 0;
+  if (diag_enabled < 0) {
+    diag_enabled = (getenv("SPS_BLOCK_DIAG") != NULL) ? 1 : 0;
+    const char *dump_path = getenv("SPS_BLOCK_DUMP");
+    if (dump_path != NULL)
+      dump = fopen(dump_path, "wb");
+  }
+  if ((diag_enabled == 0) && (dump == NULL))
+    return;
+  count++;
+  if ((dump != NULL) && (count <= 3000)) {
+    fwrite(incoming_data, 1, incoming_data_length, dump);
+    fflush(dump);
+  }
+  if ((diag_enabled != 0) && ((count % 50) == 1)) {
+    double peak = 0.0;
+    int channels = 0, format = -1, samples = 0;
+    if ((ret == 0) && (decoded_frame != NULL)) {
+      format = decoded_frame->format;
+      samples = decoded_frame->nb_samples;
+#if LIBAVUTIL_VERSION_MAJOR >= 57
+      channels = decoded_frame->ch_layout.nb_channels;
+#else
+      channels = decoded_frame->channels;
+#endif
+      if (format == AV_SAMPLE_FMT_FLTP) {
+        int c, i;
+        for (c = 0; c < channels; c++) {
+          float *plane = (float *)decoded_frame->extended_data[c];
+          if (plane != NULL)
+            for (i = 0; i < samples; i++)
+              if (fabsf(plane[i]) > peak)
+                peak = fabsf(plane[i]);
+        }
+      } else if ((format == AV_SAMPLE_FMT_S16P) || (format == AV_SAMPLE_FMT_S32P)) {
+        int c, i;
+        for (c = 0; c < channels; c++) {
+          if (decoded_frame->extended_data[c] == NULL)
+            continue;
+          for (i = 0; i < samples; i++) {
+            double value = (format == AV_SAMPLE_FMT_S16P)
+                               ? ((int16_t *)decoded_frame->extended_data[c])[i] / 32768.0
+                               : ((int32_t *)decoded_frame->extended_data[c])[i] / 2147483648.0;
+            if (fabs(value) > peak)
+              peak = fabs(value);
+          }
+        }
+      }
+    }
+    debug(1,
+          "BLOCK %u: codec \"%s\" bytes %zd ret %d format %d samples %d channels %d peak %.6f",
+          count, (conn->codec != NULL) ? conn->codec->name : "?", incoming_data_length, ret,
+          format, samples, channels, peak);
+  }
 }
 
 // take a block of incoming data and decode it.
@@ -1304,6 +1370,8 @@
         } else {
           ret = avcodec_receive_frame(conn->codec_context, decoded_frame);
 
+          block_diagnostics(conn, incoming_data, incoming_data_length, ret, decoded_frame);
+
           if (ret < 0) {
             av_frame_free(&decoded_frame);
             decoded_frame = NULL;
