config BR2_PACKAGE_NQPTP8
	bool "nqptp8"
	depends on !BR2_PACKAGE_NQPTP
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBCONFIG
	help
	  NQPTP 1.2.8, the PTP timing companion of Shairport Sync 5.

	  Buildroot ships 1.2.4; Shairport Sync 5.5 passes activity
	  information to NQPTP and its release notes ask for NQPTP to
	  be updated alongside it.

	  https://github.com/mikebrady/nqptp
