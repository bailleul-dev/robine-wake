{
  "name": "robine-wake-expo",
  "version": "0.2.1",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "expo": "^58.0.16",
    "expo-blur": "~58.0.5",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "build": "gleam build --warnings-as-errors",
    "start": "npm run build && expo start --dev-client",
    "web": "npm run build && expo start --web",
    "web:export": "npm run build && expo export --platform web --output-dir ../priv/web && bash ./scripts/cache-bust-favicon.sh",
    "ios": "npm run build && expo run:ios",
    "android": "npm run build && expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "gleam build --warnings-as-errors",
    "test": "gleam test"
  },
  "private": true
}
