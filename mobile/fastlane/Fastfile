default_platform(:android)

PACKAGE_NAME = ENV.fetch("FASTLANE_ANDROID_PACKAGE", "fr.robine.wake")
PROJECT_ROOT = File.expand_path("..", __dir__)
ANDROID_DIR = File.join(PROJECT_ROOT, "android")
OUTPUT_DIR = File.expand_path("../../build/android", __dir__)
AAB_PATH = File.join(ANDROID_DIR, "app/build/outputs/bundle/release/app-release.aab")
PLAY_TRACKS = %w[internal alpha beta production].freeze
IOS_APP_IDENTIFIER = ENV.fetch("FASTLANE_APP_IDENTIFIER", "fr.robine.wake")
IOS_APP_NAME = ENV.fetch("FASTLANE_APP_NAME", "Robine Wake")
IOS_OUTPUT_DIR = File.expand_path("../../build/ios", __dir__)
IOS_WORKSPACE = File.join(PROJECT_ROOT, "ios/RobineWake.xcworkspace")
IOS_SCHEME = "RobineWake"

def require_env(name)
  value = ENV[name]
  UI.user_error!("#{name} is required") if value.to_s.empty?
  value
end

def play_json_key_options
  if !ENV["PLAY_JSON_KEY_DATA"].to_s.empty?
    { json_key_data: ENV["PLAY_JSON_KEY_DATA"] }
  elsif !ENV["PLAY_JSON_KEY_FILE"].to_s.empty?
    { json_key: ENV["PLAY_JSON_KEY_FILE"] }
  else
    UI.user_error!("PLAY_JSON_KEY_FILE or PLAY_JSON_KEY_DATA is required")
  end
end

# The native projects are generated by Expo and ignored by Git. The version code
# and build number go through app.config.js so a clean prebuild always carries
# them.
def prebuild(platform, env)
  Dir.chdir(PROJECT_ROOT) do
    sh("npm", "run", "typecheck")
    # CocoaPods is not in the Gemfile, so pod install must run outside Bundler.
    Bundler.with_unbundled_env do
      sh(env, "npx", "expo", "prebuild", "--clean", "--platform", platform)
    end
  end
end

def next_version_code
  codes = PLAY_TRACKS.flat_map do |track|
    google_play_track_version_codes(package_name: PACKAGE_NAME, track: track, **play_json_key_options)
  rescue StandardError => e
    UI.important("Could not read #{track} track: #{e.message}")
    []
  end
  (codes.map(&:to_i).max || 0) + 1
end

# Signing is injected as Gradle properties so the regenerated android/ project
# never needs to be patched.
def signing_properties
  keystore = File.expand_path(require_env("ANDROID_KEYSTORE_FILE"), File.expand_path("../..", __dir__))
  UI.user_error!("Keystore not found: #{keystore}") unless File.exist?(keystore)

  store_password = require_env("ANDROID_KEYSTORE_PASSWORD")
  {
    "android.injected.signing.store.file" => keystore,
    "android.injected.signing.store.password" => store_password,
    "android.injected.signing.key.alias" => require_env("ANDROID_KEY_ALIAS"),
    "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"].to_s.empty? ? store_password : ENV["ANDROID_KEY_PASSWORD"]
  }
end

def build_bundle(version_code)
  properties = signing_properties
  prebuild("android", { "ANDROID_VERSION_CODE" => version_code.to_s })

  gradle(
    project_dir: ANDROID_DIR,
    task: "bundle",
    build_type: "Release",
    properties: properties,
    print_command: false
  )

  FileUtils.mkdir_p(OUTPUT_DIR)
  output = File.join(OUTPUT_DIR, "RobineWake-#{version_code}.aab")
  FileUtils.cp(AAB_PATH, output)
  UI.success("Android App Bundle: #{output}")
  output
end

def app_store_connect_key
  key_id = ENV["ASC_KEY_ID"]
  return nil if key_id.to_s.empty?

  issuer_id = ENV["ASC_ISSUER_ID"]
  UI.user_error!("ASC_ISSUER_ID is required when ASC_KEY_ID is set") if issuer_id.to_s.empty?

  options = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1_200,
    in_house: false
  }

  if ENV["ASC_KEY_CONTENT"].to_s.empty?
    key_filepath = ENV["ASC_KEY_FILEPATH"]
    UI.user_error!("ASC_KEY_FILEPATH or ASC_KEY_CONTENT is required when ASC_KEY_ID is set") if key_filepath.to_s.empty?
    options[:key_filepath] = key_filepath
  else
    options[:key_content] = ENV["ASC_KEY_CONTENT"]
    options[:is_key_content_base64] = ENV["ASC_KEY_CONTENT_BASE64"] == "true"
  end

  app_store_connect_api_key(**options)
end

platform :ios do
  desc "Build and upload a new Robine Wake beta to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_key
    development_team =
      ENV["FASTLANE_TEAM_ID"].to_s.empty? ? ENV["APPLE_TEAM_ID"] : ENV["FASTLANE_TEAM_ID"]
    UI.user_error!("FASTLANE_TEAM_ID or APPLE_TEAM_ID is required") if development_team.to_s.empty?

    # produce only works with an Apple ID session; with an API key the app is
    # expected to exist already.
    unless api_key
      produce(
        app_identifier: IOS_APP_IDENTIFIER,
        app_name: IOS_APP_NAME,
        language: "fr-FR",
        sku: IOS_APP_IDENTIFIER
      )
    end

    FileUtils.mkdir_p(IOS_OUTPUT_DIR)
    get_certificates(output_path: IOS_OUTPUT_DIR)
    get_provisioning_profile(
      app_identifier: IOS_APP_IDENTIFIER,
      adhoc: false,
      output_path: IOS_OUTPUT_DIR
    )
    profile_name = Actions.lane_context[SharedValues::SIGH_NAME] || ENV["SIGH_PROFILE_NAME"]
    UI.user_error!("Fastlane did not return an App Store provisioning profile") if profile_name.to_s.empty?

    build_number = options[:build_number]
    if build_number.to_s.empty?
      latest_options = {
        app_identifier: IOS_APP_IDENTIFIER,
        initial_build_number: 20
      }
      latest_options[:api_key] = api_key if api_key
      build_number = latest_testflight_build_number(**latest_options) + 1
    end

    prebuild("ios", { "APPLE_TEAM_ID" => development_team, "IOS_BUILD_NUMBER" => build_number.to_s })

    # The archive is signed automatically like `make expo-iphone`; only the
    # export is pinned to the App Store profile.
    build_app(
      workspace: IOS_WORKSPACE,
      scheme: IOS_SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          IOS_APP_IDENTIFIER => profile_name
        }
      },
      output_directory: IOS_OUTPUT_DIR,
      output_name: "RobineWake",
      xcargs: "DEVELOPMENT_TEAM=#{development_team} -allowProvisioningUpdates",
      clean: true
    )

    upload_options = {
      app_identifier: IOS_APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    }
    upload_options[:api_key] = api_key if api_key
    upload_options[:changelog] = options[:changelog] unless options[:changelog].to_s.empty?
    upload_to_testflight(**upload_options)
  end
end

platform :android do
  desc "Validate that the Play service account can reach the app"
  lane :verify do
    validate_play_store_json_key(**play_json_key_options)
    UI.success("Next version code: #{next_version_code}")
  end

  desc "Build a signed Android App Bundle without uploading it"
  lane :build do |options|
    version_code = options[:version_code].to_s.empty? ? 1 : options[:version_code]
    build_bundle(version_code)
  end

  desc "Build and upload a new Robine Wake release to a Google Play track (internal by default)"
  lane :beta do |options|
    track = options[:track].to_s.empty? ? ENV.fetch("PLAY_TRACK", "internal") : options[:track]
    release_status =
      options[:release_status].to_s.empty? ? ENV.fetch("PLAY_RELEASE_STATUS", "completed") : options[:release_status]

    version_code = options[:version_code].to_s.empty? ? next_version_code : options[:version_code]
    aab = build_bundle(version_code)

    upload_options = {
      package_name: PACKAGE_NAME,
      track: track,
      release_status: release_status,
      aab: aab,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: options[:changelog].to_s.empty?
    }.merge(play_json_key_options)

    unless options[:changelog].to_s.empty?
      changelog_dir = File.join(__dir__, "metadata/android/fr-FR/changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "#{version_code}.txt"), options[:changelog].to_s[0, 500])
      upload_options[:metadata_path] = File.join(__dir__, "metadata/android")
    end

    upload_to_play_store(**upload_options)
  end
end
