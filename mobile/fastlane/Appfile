package_name(ENV.fetch("FASTLANE_ANDROID_PACKAGE", "fr.robine.wake"))

apple_id(ENV["FASTLANE_USER"]) unless ENV["FASTLANE_USER"].to_s.empty?
apple_team_id = ENV["FASTLANE_TEAM_ID"].to_s.empty? ? ENV["APPLE_TEAM_ID"] : ENV["FASTLANE_TEAM_ID"]
team_id(apple_team_id) unless apple_team_id.to_s.empty?
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) unless ENV["FASTLANE_ITC_TEAM_ID"].to_s.empty?
