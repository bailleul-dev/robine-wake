import placement from "../../../../assets/perfboard-pi3/placement.svg?raw";
import step1 from "../../../../assets/perfboard-pi3/step1-links.svg?raw";
import step2 from "../../../../assets/perfboard-pi3/step2-power-uart.svg?raw";
