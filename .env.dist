# Copy this file to .env and fill only the values needed by your setup.
# The .env file is sourced as a shell file: quote values containing spaces or #.

# Raspberry Pi / Nerves (optional; without these, public firmware is Ethernet-only)
ROBINE_WIFI_SSID=''
ROBINE_WIFI_PASSPHRASE=''
ROBINE_FWUP_PRIVATE_KEY=''

# Local host emulator (optional)
ROBINE_ADMIN_USERNAME='admin'
ROBINE_ADMIN_PASSWORD=''
ROBINE_WEB_PORT='4110'
ROBINE_DEV_PORT='4111'
ROBINE_ALSA_DEVICE='default'
ROBINE_ALSA_MIXER_CONTROL='Digital'

# ESP32 remote button (optional; empty Wi-Fi values build an unprovisioned binary)
REMOTE_BUTTON_WAKE_HOST='robine-wake.local'
REMOTE_BUTTON_ID=''
REMOTE_BUTTON_SECRET_HEX=''

# Local iOS deployment (required only by make iphone / make expo-iphone)
IPHONE_ID=''
APPLE_TEAM_ID=''

# Fastlane / TestFlight (required only by make testflight)
FASTLANE_USER=''
FASTLANE_TEAM_ID=''
FASTLANE_ITC_TEAM_ID=''
ASC_KEY_ID=''
ASC_ISSUER_ID=''
ASC_KEY_FILEPATH=''
ASC_KEY_CONTENT=''
ASC_KEY_CONTENT_BASE64='false'
SIGH_PROFILE_NAME=''

# Fastlane / Google Play (required only by make play-store / make android-bundle)
# Paths are relative to the repository root. Keep the keystore out of Git and backed up.
ANDROID_KEYSTORE_FILE=''
ANDROID_KEYSTORE_PASSWORD=''
ANDROID_KEY_ALIAS='upload'
ANDROID_KEY_PASSWORD=''
PLAY_JSON_KEY_FILE=''
PLAY_JSON_KEY_DATA=''
# internal, alpha, beta or production
PLAY_TRACK='internal'
# Use 'draft' until the app has passed its first Play review.
PLAY_RELEASE_STATUS='completed'
JAVA_HOME_ANDROID=''
