---
import "../styles/wiring.css";
import { KINDS, type Kind } from "./kinds";

interface Props {
  /** physical pin number -> short label (kept short: it is printed vertically) */
  used: Record<number, { kind: Kind; label: string }>;
  alt: string;
  caption?: string;
}
const { used, alt, caption } = Astro.props;

// Landscape view, SD card slot on the left, header along the top edge:
// top row = even pins (outer row, nearest the board edge), bottom row = odd pins.
const COL = 34, LEFT = 36, TOPY = 120, ROWGAP = 36;
const W = LEFT * 2 + COL * 19 + 20, H = TOPY + ROWGAP + 130;
const pins = Array.from({ length: 40 }, (_, i) => {
  const n = i + 1;
  const col = Math.floor(i / 2);
  const top = n % 2 === 0;
  return { n, col, top, x: LEFT + col * COL, y: top ? TOPY : TOPY + ROWGAP, use: used[n] };
});
const kinds = [...new Set(Object.values(used).map((u) => u.kind))];
---
<figure class="wiring-fig">
  <div class="wiring-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt}>
      <text class="note muted" x={LEFT - 26} y={TOPY - 96} text-anchor="start">◀ SD card slot side</text>
      <text class="note muted" x={W - 20} y={TOPY - 96} text-anchor="end">far end ▶</text>
      <rect class="box" x={LEFT - 22} y={TOPY - 20} width={COL * 19 + 44} height={ROWGAP + 40} rx="8" />
      {pins.map((p) => {
        const k = p.use?.kind;
        return (
          <g class={k ? `k-${k}` : ""}>
            <circle class={k ? "pin-dot-used" : "pin-dot"} cx={p.x} cy={p.y} r="12" />
            <text x={p.x} y={p.y + 3.5} text-anchor="middle" style={`font-size:10px;font-weight:700;${k ? "fill:var(--sl-color-bg)" : ""}`}>{p.n}</text>
            {k && (
              <text
                class="used-label"
                style="font-size:11px;font-weight:700"
                transform={`translate(${p.x + 4},${p.top ? p.y - 18 : p.y + 18}) rotate(${p.top ? -90 : 90})`}
                text-anchor={p.top ? "start" : "start"}
              >{p.use!.label}</text>
            )}
          </g>
        );
      })}
      <text class="note muted" x={LEFT + COL * 9.5} y={TOPY + ROWGAP + 112} text-anchor="middle">top row = even pins (outer row, nearest the board edge) · bottom row = odd pins</text>
    </svg>
  </div>
  <div class="wiring-legend">
    {kinds.map((k) => (<span class={`k-${k}`}><i></i>{KINDS[k]}</span>))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
