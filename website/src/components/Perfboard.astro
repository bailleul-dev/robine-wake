---
// Inlines a perfboard figure generated by hardware/perfboard_s3/perfboard.py.
interface Props { svg: string; }
const { svg } = Astro.props;
---
<div class="perfboard" role="group">
  <Fragment set:html={svg} />
</div>
<style is:global>
  .perfboard { overflow-x: auto; margin: 1.25rem 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: #fff; }
  .perfboard svg { display: block; min-width: 900px; width: 100%; height: auto; }
</style>
